{
  "manifest_version": 3,
  "name": "Poshmark to Mercari Autofill",
  "version": "1.0.0",
  "description": "Navigate to your Poshmark listing on a page and in a click of a button, import them into Mercari's selling form with all details and photos pre-filled.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/selector.js"],
      "css": ["src/selector.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.mercari.com/sell/*"],
      "js": ["mercari-autofill.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://poshmark.com/listing/*"],
      "js": ["crosspost-button.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
